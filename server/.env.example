NODE_ENV=development
PORT=5000
PREFER_LOCAL_DEV_SERVICES=true

MONGO_URI_LOCAL=mongodb://localhost:27017/dsa-platform
ML_SERVICE_URL_LOCAL=http://localhost:8000

JWT_SECRET=replace_me
JWT_EXPIRE=30d

JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=replace_me
JUDGE0_LANGUAGE_ID_JAVA=62
GROQ_API_KEY=replace_me
GROQ_MODEL=openai/gpt-oss-120b

# Groq is always tried first; Ollama is the automatic fallback.
# Add local RAG retrieval context to Groq responses:
# CHAT_PROVIDER=groq-rag
# Or use Groq without RAG retrieval:
# CHAT_PROVIDER=groq
# Optional local RAG service for retrieval; Ollama fallback calls Ollama directly:
# CHATBOT_SERVICE_URL=http://127.0.0.1:8100
# CHATBOT_RETRIEVAL_TIMEOUT_MS=10000
# CHATBOT_TIMEOUT_MS=120000
# CHATBOT_API_TOKEN=
# Direct Ollama fallback settings:
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_CHAT_MODEL=qwen2.5-coder:7b
# OLLAMA_TIMEOUT_MS=120000

# Optional remote overrides when you intentionally want non-local services in development:
# MONGO_URI=mongodb+srv://...
# ML_SERVICE_URL=https://your-ml-service.example.com
