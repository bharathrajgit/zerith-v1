CHATBOT_HOST=127.0.0.1
CHATBOT_PORT=8100
CHATBOT_CORPUS_DIR=./rag-corpus
# Set to a long random value if the service is reachable from another host.
# CHATBOT_API_TOKEN=
# CHATBOT_ADMIN_TOKEN=

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=4096

QDRANT_COLLECTION=zerith-coding-knowledge
# By default the service uses Qdrant's persistent embedded mode.
# Set QDRANT_URL to use a Qdrant server for multiple workers/hosts.
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
# QDRANT_PATH=./qdrant-storage

RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_EMBED_BATCH_SIZE=32
CHATBOT_REQUEST_TIMEOUT_SECONDS=120
